rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fonctions utilitaires ──────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isPremium() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.premium == true;
    }
    function isNewGhost() {
      // Champs obligatoires présents + types/plages valides
      // ⚠️ 600 = même plafond que le textarea #depositMsg (maxlength="600" +
      // compteur "/600" dans index.html) — pas 280 (ancien plafond désynchronisé
      // de l'UI, qui aurait fait échouer tout dépôt de message entre 281 et 600
      // caractères).
      return request.resource.data.keys().hasAll(['message', 'authorUid', 'lat', 'lng'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 600
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180;
    }
    // Plafonds de taille sur les champs texte libres optionnels d'un ghost —
    // aucune contrainte n'existait auparavant, un client malveillant pouvait
    // pousser des chaînes proches du plafond Firestore par champ (audit 4.7).
    // Les valeurs `null` (sentinel utilisé par WorldService.createGhost() pour
    // un champ non renseigné) sont explicitement laissées passer.
    function hasValidTextFieldSizes() {
      return (request.resource.data.get('location', null) == null || request.resource.data.location.size() <= 120)
        && (request.resource.data.get('author', null) == null || request.resource.data.author.size() <= 100)
        && (request.resource.data.get('chainHint', null) == null || request.resource.data.chainHint.size() <= 120)
        && (request.resource.data.get('promoCode', null) == null || request.resource.data.promoCode.size() <= 40)
        && (request.resource.data.get('dedicatedTo', null) == null || request.resource.data.dedicatedTo.size() <= 100)
        && (request.resource.data.get('radius', null) == null || request.resource.data.radius.size() <= 10)
        && (request.resource.data.get('duration', null) == null || request.resource.data.duration.size() <= 20)
        // Réconciliation Cloudinary (audit 3.2) : public_id/resource_type
        // capturés à l'upload, utilisés par le trigger onDelete pour supprimer
        // le média associé quand le fantôme expire ou est effacé.
        // ⚠️ Ces champs restent entièrement contrôlés par le client à la
        // création (comme audioUrl/photoUrl/videoUrl déjà aujourd'hui) : un
        // client malveillant pourrait en théorie y placer le public_id d'un
        // autre asset Ghostub, pour en déclencher la suppression quand SON
        // propre fantôme expire. Risque préexistant (déjà vrai pour les *Url
        // eux-mêmes), pas introduit par ce chantier, non traité ici.
        && (request.resource.data.get('audioPublicId', null) == null || request.resource.data.audioPublicId.size() <= 150)
        && (request.resource.data.get('audioResourceType', null) == null || request.resource.data.audioResourceType.size() <= 150)
        && (request.resource.data.get('photoPublicId', null) == null || request.resource.data.photoPublicId.size() <= 150)
        && (request.resource.data.get('photoResourceType', null) == null || request.resource.data.photoResourceType.size() <= 150)
        && (request.resource.data.get('videoPublicId', null) == null || request.resource.data.videoPublicId.size() <= 150)
        && (request.resource.data.get('videoResourceType', null) == null || request.resource.data.videoResourceType.size() <= 150);
    }
    function isPremiumOnlyField() {
      // Champs réservés Premium dans un ghost
      return request.resource.data.get('videoUrl', null) != null
          || request.resource.data.get('duration', '') == '♾ Éternel'
          || request.resource.data.get('duration', '') == 'Eternal'
          || request.resource.data.get('chainHint', null) != null
          || request.resource.data.get('chainLat', null) != null
          || request.resource.data.get('chainLng', null) != null
          || (request.resource.data.get('openCondition', 'always') == 'after')
          || (request.resource.data.get('openCondition', 'always') == 'future')
          || request.resource.data.get('businessMode', false) == true
          || request.resource.data.get('promoCode', null) != null;
    }
    function cooldownOk() {
      // ⚠️ Doit rester identique à DEPOSIT.COOLDOWN_MS dans services/world.service.js
      // (15 min = 900000 ms). Free uniquement — Premium contourne le cooldown (voir allow create).
      let uPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let lastCreated = exists(uPath) ? get(uPath).data.get('lastGhostCreatedAt', null) : null;
      return lastCreated == null || request.time.toMillis() - lastCreated.toMillis() >= 900000;
    }
    // Propriétaire réel d'un fantôme référencé — utilisé pour vérifier qu'une
    // notification/découverte pointe vers une véritable interaction plutôt que
    // vers un UID/fantôme choisis arbitrairement (cf. Audit-5).
    function ghostAuthor(gid) {
      return get(/databases/$(database)/documents/ghosts/$(gid)).data.authorUid;
    }
    // Valide une valeur de traceColor (Lot K) : doit être une des 6 teintes
    // connues, et une teinte Premium (amber/rose/crimson) exige isPremium()
    // — sinon un compte gratuit pourrait forcer une teinte réservée en
    // écrivant directement Firestore (contournement de l'UI).
    function isValidTraceColorValue(color) {
      return color in ['spirit', 'violet', 'mist', 'amber', 'rose', 'crimson']
        && (!(color in ['amber', 'rose', 'crimson']) || isPremium());
    }

    // ── Ghosts ────────────────────────────────────────
    match /ghosts/{ghostId} {
      // Lecture : authentifié, mais un fantôme secret n'est lisible que par son auteur.
      // Note : pour une requête list/query, Firestore évalue cette règle document par
      // document et exclut silencieusement ceux qui échouent (pas d'erreur globale).
      allow read: if isAuth() && (
        resource.data.get('secret', false) != true
        || resource.data.authorUid == request.auth.uid
      );

      // Création : authentifié + champs valides
      // Si champs Premium présents → vérifier premium === true côté serveur
      // Cooldown de 15 min entre deux dépôts pour les comptes gratuits
      // Liste exhaustive établie depuis WorldService.createGhost() (services/world.service.js)
      // + dedicatedTo/attachments (calculés dans depositGhost() côté app.js, cf. rapport)
      // + _welcome (flag posé par _seedWelcomeGhost() dans app.js, cf. DIAGNOSTIC-DEPOT-REFUSE.md)
      allow create: if isAuth()
        && isNewGhost()
        && request.resource.data.keys().hasOnly([
             'message', 'location', 'emoji', 'duration', 'radius',
             'audioUrl', 'photoUrl', 'videoUrl', 'attachments',
             'audioPublicId', 'audioResourceType',
             'photoPublicId', 'photoResourceType',
             'videoPublicId', 'videoResourceType',
             'openCondition', 'openHour', 'openAfterGhostId', 'openDate',
             'businessMode', 'promoCode', 'maxOpenCount',
             'anonymous', 'secret', 'dedicatedTo',
             'chainHint', 'chainLat', 'chainLng',
             'author', 'authorUid', 'lat', 'lng',
             'geohash', 'geohash4',
             'resonances', 'activityScore', 'discoveriesCount', 'openCount',
             'lastPresenceAt', 'state', 'expired', 'createdAt',
             '_welcome'
           ])
        && (!isPremiumOnlyField() || isPremium())
        && hasValidTextFieldSizes()
        // A2-bis : maxOpenCount > 1 (5/10 lectures) réservé Premium — 1 (ou absence
        // du champ, cas gratuit) reste ouvert à tous. Règle séparée de
        // isPremiumOnlyField() car la valeur par défaut ne doit pas bloquer le gratuit.
        && (
          !('maxOpenCount' in request.resource.data)
          || request.resource.data.maxOpenCount <= 1
          || isPremium()
        )
        && (isPremium() || cooldownOk());

      // Mise à jour : propriétaire uniquement (sauf openCount/resonances/reportCount mis à jour par tous)
      allow update: if isAuth() && (
        // Propriétaire peut modifier son fantôme, mais :
        //  - authorUid/lat/lng/message ne peuvent plus changer après la création
        //    (message : contenu du "message laissé derrière soi", immuable une
        //    fois déposé — aucun code de l'app ne le modifie après coup)
        //  - idem pour les *PublicId/*ResourceType Cloudinary (audit 3.2) :
        //    immuables après création, comme les champs ci-dessus
        //  - si des champs Premium sont touchés par cette mise à jour, la même
        //    vérification qu'à la création s'applique (pas de contournement via update)
        //  - les plafonds de taille des champs texte libres (4.7) s'appliquent
        //    aussi en mise à jour, pas seulement à la création
        (
          resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.lat == resource.data.lat
          && request.resource.data.lng == resource.data.lng
          && request.resource.data.message == resource.data.message
          && request.resource.data.get('audioPublicId', null) == resource.data.get('audioPublicId', null)
          && request.resource.data.get('audioResourceType', null) == resource.data.get('audioResourceType', null)
          && request.resource.data.get('photoPublicId', null) == resource.data.get('photoPublicId', null)
          && request.resource.data.get('photoResourceType', null) == resource.data.get('photoResourceType', null)
          && request.resource.data.get('videoPublicId', null) == resource.data.get('videoPublicId', null)
          && request.resource.data.get('videoResourceType', null) == resource.data.get('videoResourceType', null)
          && hasValidTextFieldSizes()
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['videoUrl', 'duration', 'chainHint', 'openCondition', 'businessMode', 'promoCode'])
            || (!isPremiumOnlyField() || isPremium())
          )
        )
        // Tout utilisateur peut incrémenter openCount/resonances/viewCount/
        // reportCount, et un visiteur non-propriétaire qui découvre le fantôme
        // peut mettre à jour sa présence (WorldService.registerPresence()) :
        // activityScore (+1 exactement), lastPresenceAt (horloge serveur
        // uniquement, anti-forgerie), discoveriesCount (+1 exactement, optionnel
        // — seulement à la toute première découverte). reportCount (audit 1.2)
        // était absent de cette liste blanche : chaque signalement échouait
        // silencieusement, le seuil de modération ne pouvait jamais compter.
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['openCount', 'resonances', 'viewCount', 'activityScore', 'lastPresenceAt', 'discoveriesCount', 'reportCount'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['openCount'])
            || request.resource.data.openCount == resource.data.get('openCount', 0) + 1
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['resonances'])
            || request.resource.data.resonances == resource.data.get('resonances', 0) + 1
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewCount'])
            || request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activityScore'])
            || request.resource.data.activityScore == resource.data.get('activityScore', 0) + 1
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastPresenceAt'])
            || request.resource.data.lastPresenceAt == request.time
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['discoveriesCount'])
            || request.resource.data.discoveriesCount == resource.data.get('discoveriesCount', 0) + 1
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reportCount'])
            || request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
          )
        )
      );

      // Suppression : propriétaire uniquement
      allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;
    }

    // ── Users ─────────────────────────────────────────
    match /users/{userId} {
      // Lecture : propriétaire du compte
      allow read: if isOwner(userId);

      // Création/mise à jour : propriétaire
      // Champ premium ne peut être écrit que par une Cloud Function (admin SDK)
      // lastGhostCreatedAt (utilisé pour le cooldown de dépôt) ne peut être écrit
      // qu'avec l'horloge serveur — sinon un client pourrait forger une ancienne
      // date pour toujours paraître "refroidi" et contourner le cooldown.
      // traceColor (Lot K) : seul le propriétaire peut l'écrire (déjà garanti par
      // isOwner ci-dessous), et uniquement parmi les 6 teintes connues — les 3
      // Premium (amber/rose/crimson) exigent isPremium() côté serveur, l'ancienne
      // règle ne validait que la forme du document, pas cette valeur (finalisation
      // Lots K/L). ⚠️ Liste à garder synchronisée avec TRACE_COLORS dans app.js.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['premium'])
        && (
          !request.resource.data.keys().hasAny(['lastGhostCreatedAt'])
          || request.resource.data.lastGhostCreatedAt == request.time
        )
        && (
          !request.resource.data.keys().hasAny(['traceColor'])
          || isValidTraceColorValue(request.resource.data.traceColor)
        );
      allow update: if (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['premium'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastGhostCreatedAt'])
          || request.resource.data.lastGhostCreatedAt == request.time
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['traceColor'])
          || isValidTraceColorValue(request.resource.data.traceColor)
        )
      )
      // Non-owner : incrément dénormalisé de totalResonances lors d'une résonance
      // sur un fantôme de cet utilisateur (window.resonate() dans app.js) — audit
      // 1.2, ce compteur alimentant le classement "Top chasseurs" ne pouvait
      // jamais s'incrémenter faute de règle, faussant silencieusement le
      // classement en permanence.
      || (
        isAuth()
        && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalResonances'])
        && request.resource.data.totalResonances == resource.data.get('totalResonances', 0) + 1
      );
    }

    // ── UserStats ─────────────────────────────────────
    // dailyOpens (quota d'ouvertures) n'est incrémenté que par la Cloud Function
    // checkAndConsumeOpen (admin SDK, hors règles). isDevAccount accorde un bypass
    // illimité et ne doit être posé que depuis la console Firebase (admin SDK) —
    // voir CLAUDE.md. Le client ne peut écrire que ses propres champs non sensibles
    // (ex. discoveries, cf. addDiscovery() dans app.js).
    match /userStats/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['dailyOpens', 'isDevAccount']);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['dailyOpens', 'isDevAccount']);
    }

    // ── Replies ───────────────────────────────────────
    match /replies/{replyId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.message.size() <= 280;
      allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;
    }

    // ── Notifications ─────────────────────────────────
    // Schéma établi depuis les 4 sites d'écriture client dans app.js
    // (_notifyNearbyUsers, sendReply, sendMicroReply, sendQuickReaction, _doOpenEnvelope).
    // ⚠️ AUDIT-5 : l'ancienne règle ne vérifiait que la FORME du document (types/
    // clés), jamais sa relation à une interaction réelle — n'importe quel compte
    // authentifié connaissant l'UID d'une victime pouvait lui fabriquer une fausse
    // notification (fromAuthor/reactionContent en texte libre, ghostId/toUid non
    // vérifiés). Corrigé : toUid doit être le véritable propriétaire du fantôme
    // référencé, et pour type=reply, un vrai document /replies doit prouver
    // l'interaction (pas seulement la forme).
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.toUid == request.auth.uid;
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly([
             'type', 'toUid', 'ghostId', 'theirGhostId', 'replyId', 'ghostLocation',
             'fromAuthor', 'reactionContent', 'notified', 'createdAt'
           ])
        && request.resource.data.type in ['reply', 'open', 'biz_open', 'nearby_new']
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.get('fromAuthor', '').size() <= 100
        && request.resource.data.get('reactionContent', '').size() <= 200
        && exists(/databases/$(database)/documents/ghosts/$(request.resource.data.ghostId))
        && (
          // reply : le fantôme référencé appartient bien au destinataire, ET un
          // vrai document /replies (même auteur, même fantôme) prouve l'interaction.
          (
            request.resource.data.type == 'reply'
            && ghostAuthor(request.resource.data.ghostId) == request.resource.data.toUid
            && exists(/databases/$(database)/documents/replies/$(request.resource.data.replyId))
            && get(/databases/$(database)/documents/replies/$(request.resource.data.replyId)).data.authorUid == request.auth.uid
            && get(/databases/$(database)/documents/replies/$(request.resource.data.replyId)).data.ghostId == request.resource.data.ghostId
          )
          // open / biz_open : le fantôme référencé appartient bien au destinataire.
          // Ne prouve pas l'ouverture physique elle-même (déjà filtrée en amont par
          // la vérification GPS cliente + le quota serveur, cf. Audit-4) — résiduel
          // documenté dans le rapport du lot.
          || (
            request.resource.data.type in ['open', 'biz_open']
            && ghostAuthor(request.resource.data.ghostId) == request.resource.data.toUid
          )
          // nearby_new : le fantôme cité (ghostId) appartient bien à l'émetteur, le
          // fantôme du destinataire (theirGhostId) lui appartient bien, et les deux
          // sont réellement proches (~300m — cf. delta ~150m dans _notifyNearbyUsers).
          || (
            request.resource.data.type == 'nearby_new'
            && ghostAuthor(request.resource.data.ghostId) == request.auth.uid
            && exists(/databases/$(database)/documents/ghosts/$(request.resource.data.theirGhostId))
            && ghostAuthor(request.resource.data.theirGhostId) == request.resource.data.toUid
            && math.abs(get(/databases/$(database)/documents/ghosts/$(request.resource.data.ghostId)).data.lat
                        - get(/databases/$(database)/documents/ghosts/$(request.resource.data.theirGhostId)).data.lat) < 0.003
            && math.abs(get(/databases/$(database)/documents/ghosts/$(request.resource.data.ghostId)).data.lng
                        - get(/databases/$(database)/documents/ghosts/$(request.resource.data.theirGhostId)).data.lng) < 0.003
          )
        );
      allow update: if isAuth() && resource.data.toUid == request.auth.uid;
    }

    // ── Discoveries ───────────────────────────────────
    // ⚠️ Piège de nommage : ici authorUid == propriétaire du fantôme découvert
    // (destinataire de la notif « ton fantôme a été découvert », cf.
    // checkDiscoveries() qui filtre where('authorUid','==',currentUser.uid)),
    // PAS l'auteur du document. Le vrai créateur (celui qui fait la découverte)
    // est discoveredByUid — seul point d'écriture : app.js loadNearbyGhosts().
    // ⚠️ AUDIT-5 : même faille que Notifications — authorUid/ghostId n'étaient pas
    // vérifiés contre un vrai fantôme secret. Corrigé : le fantôme référencé doit
    // exister, appartenir réellement à authorUid, et être marqué secret (seul cas
    // où l'app écrit dans cette collection).
    match /discoveries/{discId} {
      allow read: if isAuth() && resource.data.authorUid == request.auth.uid;
      allow create: if isAuth()
        && request.resource.data.discoveredByUid == request.auth.uid
        && request.resource.data.discoveredByUid != request.resource.data.authorUid
        && request.resource.data.keys().hasOnly([
             'ghostId', 'ghostLocation', 'ghostMessage', 'authorUid',
             'discoveredBy', 'discoveredByUid', 'discoveredAt', 'notified'
           ])
        && request.resource.data.get('discoveredBy', '').size() <= 100
        && request.resource.data.get('ghostMessage', '').size() <= 100
        && exists(/databases/$(database)/documents/ghosts/$(request.resource.data.ghostId))
        && ghostAuthor(request.resource.data.ghostId) == request.resource.data.authorUid
        && get(/databases/$(database)/documents/ghosts/$(request.resource.data.ghostId)).data.secret == true;
      allow update: if isAuth() && resource.data.authorUid == request.auth.uid;
    }

    // ── Reports ───────────────────────────────────────
    // ⚠️ AUDIT 4.8 : ni hasOnly() ni vérification d'identité — un utilisateur
    // pouvait écrire un document de forme arbitraire et usurper l'identité du
    // signaleur (reporterUid). Impact limité (lecture admin uniquement) mais
    // corrigé par cohérence avec le reste du fichier.
    match /reports/{reportId} {
      allow read: if false; // lecture admin uniquement
      allow create: if isAuth()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['spam', 'harcèlement', 'photo_inappropriée', 'contenu_inapproprié', 'fausses_informations', 'autre']
        && request.resource.data.keys().hasOnly(['ghostId', 'ghostLocation', 'ghostAuthorUid', 'reporterUid', 'reason', 'createdAt'])
        && exists(/databases/$(database)/documents/ghosts/$(request.resource.data.ghostId))
        && ghostAuthor(request.resource.data.ghostId) == request.resource.data.ghostAuthorUid;
    }

    // ── Whispers ──────────────────────────────────────
    // Ping éphémère "quelqu'un a résonné sur ton fantôme" (Ghost Whisper),
    // un seul document par destinataire (clé = son UID), écouté en temps réel
    // par _startWhisperListener() dans app.js. ⚠️ AUDIT 1.2 : collection non
    // déclarée → refusée par le deny-all par défaut, fonctionnalité
    // entièrement morte malgré un code client complet et câblé. Corrigé :
    // écriture ouverte à tout auteur (≠ destinataire) d'une résonance réelle
    // sur un vrai fantôme appartenant au destinataire.
    match /whispers/{uid} {
      allow read: if isOwner(uid);
      allow create: if isAuth()
        && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['lastWhisper', 'ghostId', 'ghostEmoji', 'ghostLocation', 'count'])
        && request.resource.data.lastWhisper == request.time
        && request.resource.data.get('ghostEmoji', '').size() <= 8
        && request.resource.data.get('ghostLocation', '').size() <= 120
        && exists(/databases/$(database)/documents/ghosts/$(request.resource.data.ghostId))
        && ghostAuthor(request.resource.data.ghostId) == uid
        && request.resource.data.count == 1;
      allow update: if isAuth()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastWhisper', 'ghostId', 'ghostEmoji', 'ghostLocation', 'count'])
        && request.resource.data.lastWhisper == request.time
        && request.resource.data.get('ghostEmoji', '').size() <= 8
        && request.resource.data.get('ghostLocation', '').size() <= 120
        && exists(/databases/$(database)/documents/ghosts/$(request.resource.data.ghostId))
        && ghostAuthor(request.resource.data.ghostId) == uid
        && request.resource.data.count == resource.data.get('count', 0) + 1;
    }

    // ── GhostStats ────────────────────────────────────
    // Repli d'écriture pour openCount/expired quand un visiteur non-
    // propriétaire ouvre un fantôme qui expire pile à ce moment-là (le champ
    // `expired` n'est pas dans la liste blanche non-propriétaire de /ghosts,
    // cf. _doOpenEnvelope() dans app.js). ⚠️ AUDIT 1.2 : collection non
    // déclarée → refusée par le deny-all par défaut. Impact désormais limité
    // (cleanExpiredGhosts, Lot Audit-2, marque `expired` de façon fiable
    // indépendamment de ce repli) mais corrigé pour que ce chemin fonctionne
    // comme prévu plutôt que d'échouer silencieusement.
    match /ghostStats/{ghostId} {
      allow read: if isAuth() && resource.data.get('authorUid', null) == request.auth.uid;
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['openCount', 'ghostId', 'authorUid', 'expired'])
        && request.resource.data.ghostId == ghostId
        && exists(/databases/$(database)/documents/ghosts/$(ghostId))
        && ghostAuthor(ghostId) == request.resource.data.get('authorUid', null)
        && request.resource.data.openCount == 1;
      allow update: if isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openCount', 'ghostId', 'authorUid', 'expired'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['openCount'])
          || request.resource.data.openCount == resource.data.get('openCount', 0) + 1
        );
    }

    // ── PremiumCodes ──────────────────────────────────
    // Lecture/écriture via Cloud Function uniquement (admin SDK)
    match /premiumCodes/{codeId} {
      allow read, write: if false;
    }

    // ── Tout le reste — refus par défaut ──────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
